class Terrain extends Node2D:
	var seabed_y := 3200.0
	var half_w := 1300.0
	func _draw() -> void:
		var rng := RandomNumberGenerator.new()
		rng.seed = 1313
		var rock := Color(0.13, 0.15, 0.17)
		var bone := Color(0.75, 0.74, 0.66)
		# sea floor
		var pts := PackedVector2Array()
		var x := -half_w - 300.0
		while x <= half_w + 300.0:
			pts.append(Vector2(x, seabed_y + rng.randf_range(-25.0, 25.0)))
			x += rng.randf_range(20.0, 50.0)
		pts.append(Vector2(half_w + 300.0, seabed_y + 400.0))
		pts.append(Vector2(-half_w - 300.0, seabed_y + 400.0))
		draw_colored_polygon(pts, rock)
		# cliff walls
		for side in [-1.0, 1.0]:
			var w := PackedVector2Array()
			var y := 40.0
			while y <= seabed_y:
				w.append(Vector2(side * (half_w + rng.randf_range(-30.0, 40.0)), y))
				y += rng.randf_range(30.0, 90.0)
			w.append(Vector2(side * (half_w + 400.0), seabed_y))
			w.append(Vector2(side * (half_w + 400.0), 40.0))
			draw_colored_polygon(w, rock)
		# rock spikes on the floor
		for i in 30:
			var bx := rng.randf_range(-half_w, half_w)
			var h := rng.randf_range(15.0, 60.0)
			draw_colored_polygon(PackedVector2Array([Vector2(bx - 12, seabed_y + 5), Vector2(bx + rng.randf_range(-6, 6), seabed_y - h), Vector2(bx + 12, seabed_y + 5)]), rock.lightened(0.05))
		# rotting wreck
		draw_set_transform(Vector2(-650, 1700), 0.45, Vector2.ONE)
		draw_colored_polygon(PackedVector2Array([Vector2(-120, -20), Vector2(100, -20), Vector2(140, -40), Vector2(100, 20), Vector2(-110, 20)]), Color(0.22, 0.14, 0.12))
		for i in 5:
			draw_circle(Vector2(-80 + i * 38, -2), 5.0, Color(0, 0, 0))
		draw_line(Vector2(-60, -20), Vector2(-60, -70), Color(0.2, 0.13, 0.1), 3.0)
		draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)
		# giant ribcage = landmark near the creature's lair
		var rp := Vector2(450, seabed_y - 4)
		draw_line(rp + Vector2(-20, -2), rp + Vector2(270, -2), bone, 5.0)
		for i in 9:
			var cx := rp.x + i * 30.0
			var r := 85.0 - absf(float(i) - 4.0) * 9.0
			draw_arc(Vector2(cx, rp.y), r, PI, TAU, 14, bone, 3.0)


