class Sub extends Node2D:
	var vel := Vector2.ZERO
	var facing := 1.0       # smoothed, for the turning animation
	var face_dir := 1.0     # -1 / +1
	var tilt := 0.0
	var t := 0.0
	var implosion_factor := 0.0
	func _process(d: float) -> void:
		t += d
		queue_redraw()
	func _ellipse(rx: float, ry: float, n: int) -> PackedVector2Array:
		var p := PackedVector2Array()
		for i in n:
			var a := TAU * float(i) / float(n)
			p.append(Vector2(cos(a) * rx, sin(a) * ry))
		return p
	func _draw() -> void:
		var crush := clampf(implosion_factor, 0.0, 1.0)
		var sx := 1.0 - crush * 0.66
		var sy := 1.0 - crush * 0.82
		draw_set_transform(Vector2(0, sin(t * 1.7) * 0.8), tilt, Vector2(facing * sx, sy))
		# Compact deep-sea pressure capsule, not a toy: layered steel hull and armored nose.
		draw_colored_polygon(_ellipse(24.0, 10.0, 24), Color(0.12, 0.16, 0.18))
		draw_colored_polygon(_ellipse(20.0, 8.0, 24), Color(0.34, 0.39, 0.37))
