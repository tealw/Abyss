func _make_label(size: int) -> Label:
	var l := Label.new()
	l.mouse_filter = Control.MOUSE_FILTER_IGNORE
	l.add_theme_font_size_override("font_size", size)
	l.add_theme_color_override("font_color", Color(0.78, 0.95, 0.9))
	l.add_theme_color_override("font_shadow_color", Color(0, 0, 0, 0.85))
	l.add_theme_constant_override("shadow_offset_x", 2)
	l.add_theme_constant_override("shadow_offset_y", 2)
	return l


func _build_audio() -> void:
	var p := AudioStreamPlayer.new()
	var g := AudioStreamGenerator.new()
	g.mix_rate = MIX_RATE
	g.buffer_length = 0.3
	p.stream = g
	p.volume_db = -4.0
	add_child(p)
	p.play()
	gen_playback = p.get_stream_playback() as AudioStreamGeneratorPlayback


# ================================================================ INPUT

func _unhandled_input(ev: InputEvent) -> void:
	var pos := Vector2.ZERO
	var got := false
	if ev is InputEventMouseButton:
		var mb := ev as InputEventMouseButton
		if mb.button_index == MOUSE_BUTTON_LEFT and mb.pressed:
			pos = mb.position
			got = true
	elif ev is InputEventMouseMotion:
		var mm := ev as InputEventMouseMotion
		if mm.button_mask & MOUSE_BUTTON_MASK_LEFT:
			pos = mm.position
			got = true
	if not got:
		return
	if state == S.DEAD or state == S.WON:
		if dead_t > 2.0:
			get_tree().reload_current_scene()
		return
	if state == S.BOARDING or state == S.DESCENDING:
		return
	if state == S.INTERIOR:
		# Tap the console area to walk to the controls.
		target = Vector2(55.0, 0.0)
		has_target = true
		return
	target = _screen_to_world(pos)
	has_target = true
	marker.position = target


func _screen_to_world(p: Vector2) -> Vector2:
	var win := get_viewport().get_visible_rect().size
	var vs := Vector2(sub_vp.size)
	var sp := p / win * vs
	return cam.get_screen_center_position() + (sp - vs * 0.5)


# ================================================================ GAME LOOP

func _process(delta: float) -> void:
	time += delta
	photo_cd = maxf(photo_cd - delta, 0.0)
	match state:
		S.SHIP:
			_update_ship(delta)
		S.INTERIOR:
			_update_interior(delta)
		S.DESCENDING:
			_update_descend(delta)
		S.DIVING, S.ESCAPE:
			_update_dive(delta)
		S.DEAD, S.WON:
			_update_end(delta)
	marker.active = has_target and (state == S.SHIP or state == S.DIVING or state == S.ESCAPE)
	_update_camera(delta)
	_update_atmosphere(delta)
	_update_ui(delta)
	_fill_audio(delta)


func _update_ship(delta: float) -> void:
	var want := 0.0
	if has_target:
		var dx := target.x - hero.global_position.x
		if absf(dx) > 3.0:
			want = signf(dx) * 34.0
		else:
			has_target = false
	hero_vx = move_toward(hero_vx, want, 160.0 * delta)
	hero.position.x = clampf(hero.position.x + hero_vx * delta, -112.0, 108.0)
	hero.walking = absf(hero_vx) > 4.0
	if foot_silt != null:
		foot_silt.emitting = hero.walking
	if absf(hero_vx) > 4.0:
		hero.facing = signf(hero_vx)
	if hero.position.x <= -104.0:
		_board()


func _board() -> void:
	state = S.BOARDING
	has_target = false
	hero.walking = false
	hero.facing = -1.0
	var tw := create_tween()
	tw.tween_property(hero, "global_position", sub.global_position + Vector2(0, -12), 0.8).set_trans(Tween.TRANS_QUAD)
	tw.tween_callback(func() -> void:
		ship.visible = false
		sub.visible = false
		for child in world.get_children():
			if child != cam and child != interior:
				child.visible = false
		hero.reparent(world)
		hero.position = Vector2(-70.0, 8.0)
		hero.visible = true
		hero.facing = 1.0
		interior.visible = true
		interior.position = Vector2(sub_vp.size) * 0.5
		cam.position = Vector2.ZERO
		state = S.INTERIOR
		_say("CRAMPED CONTROL CAPSULE. MAX RATED DEPTH: 2,000 m. Walk to the console on the right to begin.", 8.0))


func _update_interior(delta: float) -> void:
	interior.position = Vector2(sub_vp.size) * 0.5
	var want := 0.0
	if has_target:
		var dx := 55.0 - hero.position.x
		if absf(dx) > 2.0:
			want = signf(dx) * 28.0
		else:
			has_target = false
			hero.walking = false
			hero_vx = 0.0
			state = S.DESCENDING
			interior.visible = false
			for child in world.get_children():
				if child != cam and child != interior:
					child.visible = true
			hero.visible = false
			ship.visible = true
			sub.visible = true
			sub.position = Vector2(-175.0, 8.0)
			descend_speed = 0.0
			_say("Controls engaged. The cable lowers you into black water.", 6.0)
	hero_vx = move_toward(hero_vx, want, 130.0 * delta)
	hero.position.x = move_toward(hero.position.x, 55.0, absf(hero_vx) * delta)
	hero.walking = absf(hero_vx) > 2.0
	if foot_silt != null:
		foot_silt.emitting = hero.walking
	if absf(hero_vx) > 2.0:
		hero.facing = signf(hero_vx)

func _update_descend(delta: float) -> void:
	descend_speed = move_toward(descend_speed, 38.0, 15.0 * delta)
	sub.position.y += descend_speed * delta
	sub.face_dir = 1.0
	sub.facing = move_toward(sub.facing, 1.0, 6.0 * delta)
	ship.cable_to = ship.to_local(sub.global_position + Vector2(0, -12))
	if sub.position.y > 220.0:
		ship.cable_on = false
		state = S.DIVING
		photo_btn.visible = true
		_say("Cable released. Find the creature. Tap to steer. Press PHOTO when it's in your light.", 8.0)


func _update_dive(delta: float) -> void:
	# Interior-view cockpit stays locked around the moving submersible.
	interior.position = Vector2(sub_vp.size) * 0.5
	interior.depth = sub.position.y
	interior.visible = view_inside
	# ---- natural, inertial steering toward the tapped point
	var desired := Vector2.ZERO
	var accel := 35.0
	if has_target:
		var to_t := target - sub.position
		var dist_t := to_t.length()
		if dist_t < 5.0:
			has_target = false
		else:
			desired = to_t / dist_t * minf(SUB_MAX_SPEED, dist_t * 1.6)   # eases in as it arrives
			accel = SUB_ACCEL
	sub.vel = sub.vel.move_toward(desired, accel * delta)
	sub.vel += Vector2(sin(time * 0.4), cos(time * 0.33)) * 2.0 * delta     # slow current
	sub.position += sub.vel * delta
	if sub_wake != null:
		sub_wake.emitting = sub.vel.length() > 12.0 and (state == S.DIVING or state == S.ESCAPE)
	var min_y := 40.0
	if state == S.ESCAPE:
		min_y = 0.0
	sub.position.x = clampf(sub.position.x, -HALF_W + 30.0, HALF_W - 30.0)
	sub.position.y = clampf(sub.position.y, min_y, SEABED_Y - 30.0)

	# At 2,000 m, pressure wins: darkness builds, a deep shriek sounds, then the hull implodes.
	if sub.position.y >= 2000.0 and not depth_scare_started:
		depth_scare_started = true
		view_inside = false
		interior.visible = false
		implosion_t = 0.0
		scare_env = 1.0
		event_age = 0.0
		event_kind = 3
		event_len = 4.0
		_say("MAX DEPTH EXCEEDED — 2,000 m. PRESSURE CASCADE IN PROGRESS. THE HULL IS FOLDING IN.", 5.0)
	if depth_scare_started and state == S.DIVING:
		implosion_t += delta
		sub.implosion_factor = clampf(implosion_t / 5.0, 0.0, 1.0)
		depth_blackout = clampf((sub.position.y - 2000.0) / 260.0 + implosion_t / 7.0, 0.0, 1.0)
		if implosion_t < 4.0:
			center_lbl.text = "PRESSURE CASCADE\nHULL DEFORMATION DETECTED"
			center_lbl.visible = true
			center_lbl.add_theme_color_override("font_color", Color(0.92, 0.22, 0.12, clampf(implosion_t / 1.2, 0.0, 1.0)))
		if implosion_t >= 5.0:
			_implode()
			return

	if absf(sub.vel.x) > 8.0:
		sub.face_dir = signf(sub.vel.x)
	sub.facing = move_toward(sub.facing, sub.face_dir, 5.0 * delta)
	var spd := sub.vel.length()
	var want_tilt := 0.0
	if spd > 6.0:
		want_tilt = clampf(sub.face_dir * atan2(sub.vel.y, absf(sub.vel.x) + 10.0), -0.9, 0.9)
	sub.tilt = lerpf(sub.tilt, want_tilt, 3.0 * delta)

	beam.position = Vector2(sub.facing * 20.0, 0.0).rotated(sub.tilt)
	beam.rotation = sub.tilt
	beam.scale = Vector2(sub.facing * 0.7, 0.7)

	# ---- apex creature and depth-banded hunters
	creature.target_pos = sub.position
	creature.escape = (state == S.ESCAPE)
	for hunter in deep_creatures:
		hunter.target_pos = sub.position
		hunter.escape = (state == S.ESCAPE)
		if hunter.caught:
			_die()
			return
	if creature.mode != prev_mode:
		if creature.mode == Creature.M.CHARGE:
			scare_env = maxf(scare_env, 0.35)
			shake_spike += 2.0
		prev_mode = creature.mode
	if creature.caught:
		_die()
		return
	if state == S.ESCAPE and sub.position.y < 55.0:
		_win()


func _take_photo() -> void:
	if state != S.DIVING or photo_cd > 0.0:
		return
	photo_cd = 1.5
	flash_a = 1.0
	flash_col = Color.WHITE
	click_env = 1.0
	var to_c := creature.position - sub.position
	var fwd := Vector2(sub.face_dir, 0.0).rotated(sub.tilt)
	var ang := absf(fwd.angle_to(to_c))
	if to_c.length() < 150.0 and ang < 0.9:
		photos += 1
		creature.flee()
		fear_spike = 1.0
		shake_spike += 4.0
		scare_env = maxf(scare_env, 0.5)
		if photos >= PHOTOS_NEEDED:
			state = S.ESCAPE
			photo_btn.visible = false
			_say("That's all of them. Get to the surface. NOW.", 8.0)
		else:
			_say("Photo %d of %d captured. It didn't like that." % [photos, PHOTOS_NEEDED], 5.0)
	else:
		_say("Nothing in frame. Point your light at it and get closer.", 3.0)


func _implode() -> void:
	if state == S.DEAD:
		return
	state = S.DEAD
	dead_t = 0.0
	has_target = false
	photo_btn.visible = false
	view_toggle.visible = false
	view_inside = false
	interior.visible = false
	scare_env = 1.0
	shake_spike = 18.0
	flash_a = 1.0
	flash_col = Color(0.9, 0.95, 1.0)
	sub.visible = false
	beam.energy = 0.0
	glow.energy = 0.0
	center_lbl.text = "HULL FAILURE\nPRESSURE CASCADE\n\nSUBMERSIBLE IMPLODED"
	center_lbl.visible = true
	center_lbl.add_theme_color_override("font_color", Color(1.0, 0.16, 0.12))
	view_toggle.visible = false
	view_inside = false
	interior.visible = false
	_say("...", 2.0)

func _die() -> void:
	state = S.DEAD
	dead_t = 0.0
	has_target = false
	photo_btn.visible = false
	view_toggle.visible = false
	view_inside = false
	interior.visible = false
	scare_env = 1.0
	shake_spike = 9.0
	flash_a = 0.9
	flash_col = Color(0.8, 0.05, 0.05)
	creature.frozen = true
	for hunter in deep_creatures:
		hunter.frozen = true
	creature.set_mode(Creature.M.CHARGE)
	creature.heading = 0.0
	sub.visible = false
	beam.energy = 0.0
	glow.energy = 1.6
	glow.color = Color(1.0, 0.3, 0.3)
	center_lbl.text = "THE DEEP TAKES YOU"


func _win() -> void:
	state = S.WON
	dead_t = 0.0
	creature.escape = false
	creature.flee()
	photo_btn.visible = false
	view_toggle.visible = false
	view_inside = false
	interior.visible = false
	center_lbl.text = "YOU BROKE THE SURFACE\n%d photos. Don't look at them.\n\ntap to dive again" % photos
	center_lbl.visible = true


func _update_end(delta: float) -> void:
	dead_t += delta
	if state == S.DEAD:
		if not depth_scare_started:
			var s := lerpf(creature.scale.x, 6.5, 8.0 * delta)
			creature.scale = Vector2(s, s)
			creature.position = creature.position.lerp(sub.position, 10.0 * delta)
		if dead_t > 2.4:
			center_lbl.text = ("HULL FAILURE\nSUBMERSIBLE IMPLODED\n\ntap to try again" if depth_scare_started else "THE DEEP TAKES YOU\n\ntap to try again")
			center_lbl.visible = true
			center_lbl.add_theme_color_override("font_color", Color(0.9, 0.2, 0.2))
	else:
		sub.vel = sub.vel.move_toward(Vector2.ZERO, 30.0 * delta)
		sub.position += sub.vel * delta


func _update_camera(delta: float) -> void:
	var tp := sub.position
	if state == S.SHIP or state == S.BOARDING:
		tp = hero.global_position + Vector2(0, -16)
	elif state == S.INTERIOR:
		tp = Vector2.ZERO
	elif view_inside and (state == S.DIVING or state == S.ESCAPE):
		tp = sub.position
	cam.position = tp
	var sh := fear * 1.0 + shake_spike
	if creature.mode == Creature.M.CHARGE and state != S.DEAD:
		sh += 1.5
	cam.offset = Vector2(roundf(randf_range(-1.0, 1.0) * sh), roundf(randf_range(-1.0, 1.0) * sh))
	shake_spike = move_toward(shake_spike, 0.0, 6.0 * delta)


func _update_atmosphere(delta: float) -> void:
	var depth := maxf(sub.position.y, 0.0)
	if state == S.SHIP or state == S.BOARDING or state == S.INTERIOR:
		depth = 0.0
	k_depth = clampf(depth / 900.0, 0.0, 1.0)
	canvas_mod.color = Color(0.85, 0.92, 0.95).lerp(Color(0.025, 0.035, 0.06), pow(k_depth, 0.7))
	snow.global_position = cam.get_screen_center_position()
	snow.emitting = depth > 120.0
	if ambient_bubbles != null:
		ambient_bubbles.global_position = cam.get_screen_center_position()
		ambient_bubbles.emitting = depth > 120.0 and state != S.DEAD and state != S.WON

	# fear: how close is the thing, plus short spikes (photo, charge, death)
	var dist := creature.position.distance_to(sub.position)
	var nearest := creature
	for hunter in deep_creatures:
		var hd := hunter.position.distance_to(sub.position)
		if hd < dist:
			dist = hd
			nearest = hunter
	var tgt := 0.0
	if state == S.DIVING or state == S.ESCAPE:
		tgt = clampf(1.0 - dist / 260.0, 0.0, 1.0)
		if nearest.mode == Creature.M.LURK:
			tgt *= 0.3
	fear = lerpf(fear, maxf(tgt, fear_spike), 4.0 * delta)
	fear_spike = move_toward(fear_spike, 0.0, 0.6 * delta)
	if state == S.DEAD:
		fear = 1.0

	# flickering headlight
	if state == S.DIVING or state == S.ESCAPE:
		beam.energy = 1.15 + randf() * 0.1 + (randf() - 0.5) * fear * 0.8
		if fear > 0.6 and randf() < 0.02:
			beam.energy = 0.1

	fx.set_shader_parameter("fear", fear)
	fx.set_shader_parameter("murk", k_depth)
	fx.set_shader_parameter("blackout", depth_blackout)


func _update_ui(delta: float) -> void:
	flash_a = move_toward(flash_a, 0.0, 2.5 * delta)
	flash.color = Color(flash_col.r, flash_col.g, flash_col.b, flash_a)
	hint_t -= delta
	if hint_t <= 0.0:
		hint.text = _default_hint()
	if state == S.SHIP or state == S.BOARDING:
		status.text = "M.V. HOLLOW TIDE  |  SUB RATING: MAX 2,000 m"
	elif state == S.INTERIOR:
		status.text = "PRESSURE CAPSULE  |  MAX DEPTH 2,000 m"
	else:
		status.text = "DEPTH %dm / 2,000m     PHOTOS %d/%d" % [int(sub.position.y), photos, PHOTOS_NEEDED]
	photo_btn.disabled = photo_cd > 0.0 or view_inside
	photo_btn.visible = (state == S.DIVING or state == S.ESCAPE) and not view_inside
	view_toggle.visible = state == S.DIVING or state == S.ESCAPE
	view_toggle.text = "VIEW: OUTSIDE" if view_inside else "VIEW: INSIDE"
	sonar_t -= delta
	if sonar_t <= 0.0:
		sonar_t = 0.4
		# Detail appears on the in-world green CRT, not as a top-right HUD readout.
		var v := creature.position - sub.position
		var d := v.length()
		interior.contact_strength = 1.0 if d < 900.0 else 0.0
		interior.depth = sub.position.y
		interior.visible = (state == S.INTERIOR) or (view_inside and (state == S.DIVING or state == S.ESCAPE))
		sonar.text = ""


func _default_hint() -> String:
	match state:
		S.SHIP:
			return "MISSION BRIEF: MAX DEPTH 2,000 m. Pressure beyond this rating will crush the sub. Tap to walk; board at the stern (left)."
		S.INTERIOR:
			return "Tap to walk to the controls on the right. You must start the dive yourself."
		S.DIVING:
			return "Tap/drag to steer. PHOTO the creatures. VIEW toggles the cramped red-lit cockpit; max rated depth is 2,000 m."
		S.ESCAPE:
			return "SWIM UP! Tap toward the surface."
	return ""


func _toggle_view() -> void:
	view_inside = not view_inside
	interior.visible = view_inside and (state == S.DIVING or state == S.ESCAPE)
	interior.position = Vector2(sub_vp.size) * 0.5
	interior.depth = sub.position.y
	photo_btn.visible = not view_inside and (state == S.DIVING or state == S.ESCAPE)
	view_toggle.text = "VIEW: OUTSIDE" if view_inside else "VIEW: INSIDE"


func _say(text: String, dur: float = 4.0) -> void:
	hint.text = text
	hint_t = dur


# ================================================================ PROCEDURAL AUDIO

func _fill_audio(delta: float) -> void:
	if gen_playback == null:
		return
	var n := gen_playback.get_frames_available()
	if n <= 0:
		return
	var dt := 1.0 / MIX_RATE
	var buf := PackedVector2Array()
	buf.resize(n)
	var deep := k_depth
	var beat_period := 1.1 - fear * 0.6

	# schedule a creepy one-shot (whale moan / hull creak / sonar ping)
	event_t -= delta
	if event_t <= 0.0 and event_age < 0.0:
		event_age = 0.0
		event_kind = randi() % 6
		event_len = [4.0, 2.2, 2.6, 4.0, 2.8, 3.2][event_kind]
		event_t = randf_range(7.0, 16.0) / (1.0 + fear)

	for i in n:
		var wn := randf() * 2.0 - 1.0
		ph1 += TAU * 41.0 * dt
		ph2 += TAU * 43.3 * dt
		ph3 += TAU * 82.9 * dt
		ph_lfo += TAU * 0.12 * dt
		ph_wave += TAU * 0.3 * dt
		if ph1 > TAU: ph1 -= TAU
		if ph2 > TAU: ph2 -= TAU
		if ph3 > TAU: ph3 -= TAU
		if ph_lfo > TAU: ph_lfo -= TAU
		if ph_wave > TAU: ph_wave -= TAU

		# deep drone: two detuned sines beat against each other
		var lfo := 0.65 + 0.35 * sin(ph_lfo)
		var s := (sin(ph1) * 0.22 + sin(ph2) * 0.20) * lfo * (0.5 + 0.5 * deep)
		s += sin(ph3) * 0.05 * (deep + fear)
		# pressure rumble
		lp += (wn - lp) * 0.015
		s += lp * 1.6 * (0.25 + 0.3 * deep)
		# surface wash of waves
		wash_lp += (wn - wash_lp) * 0.08
		var wv := 0.5 + 0.5 * sin(ph_wave)
		s += wash_lp * wv * wv * 0.35 * (1.0 - deep)

		# one-shot events
		if event_age >= 0.0:
			var u := event_age / event_len
			var env := sin(PI * u)
			var e := 0.0
			if event_kind == 0:       # distant moan
				var f := 220.0 - 110.0 * u + 6.0 * sin(event_age * 7.0)
				ph_e += TAU * f * dt
				e = (sin(ph_e) * 0.18 + sin(ph_e * 1.5) * 0.06) * env
			elif event_kind == 1:     # hull creak
				var f2 := 140.0 + 100.0 * absf(sin(event_age * 9.0))
				ph_e += TAU * f2 * dt
				e = signf(sin(ph_e)) * 0.05 * env * (0.6 + 0.4 * randf())
			elif event_kind == 2:     # sonar ping + echo
				ph_e += TAU * 880.0 * dt
				e = sin(ph_e) * 0.12 * exp(-event_age * 4.0)
				if event_age > 0.7:
					e += sin(ph_e) * 0.05 * exp(-(event_age - 0.7) * 4.0)
			elif event_kind == 3:     # pressure implosion: rising shriek then sub-bass crack
				var f3 := 90.0 + 780.0 * minf(u * 1.8, 1.0)
				ph_e += TAU * f3 * dt
				e = sin(ph_e) * 0.32 * env + (randf() * 2.0 - 1.0) * 0.22 * exp(-event_age * 1.4)
			elif event_kind == 4:     # creature throat groan
				var f4 := 75.0 + 24.0 * sin(event_age * 2.0) - 20.0 * u
				ph_e += TAU * f4 * dt
				e = (sin(ph_e) * 0.22 + sin(ph_e * 0.53) * 0.12) * env
			else:                     # clicking / chittering creature call
				var f5 := 420.0 + 180.0 * sin(event_age * 17.0)
				ph_e += TAU * f5 * dt
				e = signf(sin(ph_e)) * 0.10 * env * (0.5 + 0.5 * sin(event_age * 31.0))
			if ph_e > TAU: ph_e -= TAU
			s += e * (0.4 + 0.6 * deep)
			event_age += dt
			if event_age > event_len:
				event_age = -1.0

		# heartbeat
		heart_t += dt
		if heart_t > beat_period:
			heart_t -= beat_period
		if fear > 0.08:
			var b := sin(TAU * 52.0 * heart_t) * exp(-heart_t * 28.0)
			if heart_t > 0.28:
				b += 0.7 * sin(TAU * 46.0 * (heart_t - 0.28)) * exp(-(heart_t - 0.28) * 28.0)
			s += b * 0.7 * fear

		# jump-scare burst + camera click
		if scare_env > 0.0:
			s += (randf() * 2.0 - 1.0) * 0.6 * scare_env + sin(TAU * 95.0 * heart_t * 3.0) * 0.4 * scare_env
			scare_env = maxf(scare_env - dt * 1.2, 0.0)
		if click_env > 0.0:
			s += (randf() * 2.0 - 1.0) * 0.5 * click_env
			click_env = maxf(click_env - dt * 14.0, 0.0)

		s = clampf(s, -1.0, 1.0)
		buf[i] = Vector2(s, s)
	gen_playback.push_buffer(buf)
	 
