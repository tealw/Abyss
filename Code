		draw_circle(Vector2(18, 0), 4.5, Color(0.045, 0.075, 0.08))
		draw_circle(Vector2(18, 0), 3.0, Color(0.45, 0.74, 0.72))
		draw_circle(Vector2(18, 0), 1.2, Color(0.85, 1.0, 0.95))
