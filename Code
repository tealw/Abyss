class Creature extends Node2D:
	enum M { LURK, STALK, CHARGE, FLEE }
	var mode: int = M.LURK
	var vel := Vector2.ZERO
	var heading := 0.0
	var trail: Array[Vector2] = []
	var home := Vector2(420.0, 760.0)
	var target_pos := Vector2.ZERO
	var aggression := 0.0
	var escape := false
	var caught := false
	var frozen := false
	var mode_t := 0.0
	var charge_cd := 6.0
	var wander := Vector2.ZERO
	var wander_t := 0.0
	var t := 0.0
	var body_col := Color(0.55, 0.6, 0.64)
	var apex := false

	func _ready() -> void:
		wander = home
		for i in 18:
			trail.append(position - Vector2(10.0 * (i + 1), 0.0))

	func set_mode(m: int) -> void:
		mode = m
		mode_t = 0.0

	func flee() -> void:
		set_mode(M.FLEE)
		aggression = minf(aggression + 0.3, 1.0)

	func _process(d: float) -> void:
		t += d
		mode_t += d
		queue_redraw()
		if frozen:
			return
		var to_sub := target_pos - position
		var dist := to_sub.length()
		var dir := to_sub / maxf(dist, 0.001)
		var desired := Vector2.ZERO
		var accel := 60.0
		match mode:
			M.LURK:
				wander_t -= d
				if wander_t <= 0.0:
					wander_t = randf_range(3.0, 6.0)
					wander = home + Vector2(randf_range(-260.0, 260.0), randf_range(-160.0, 120.0))
				desired = (wander - position).limit_length(30.0)
				if dist < 430.0:
					set_mode(M.STALK)
					charge_cd = randf_range(5.0, 9.0)
			M.STALK:
				if escape:
					desired = dir * 74.0
					accel = 90.0
				else:
					var ring := lerpf(170.0, 85.0, aggression)
					var spd := 1.0 + aggression * 0.6
					desired = (dir * clampf((dist - ring) * 0.6, -35.0, 55.0) + Vector2(-dir.y, dir.x) * 24.0 * sin(t * 0.7)) * spd
					charge_cd -= d
					if charge_cd <= 0.0 and dist < 330.0:
						set_mode(M.CHARGE)
					elif dist > 800.0:
						set_mode(M.LURK)
			M.CHARGE:
				desired = dir * 125.0
				accel = 280.0
				if mode_t > 1.4:
					set_mode(M.STALK)
					charge_cd = maxf(randf_range(5.0, 9.0) - aggression * 3.0, 2.5)
			M.FLEE:
				desired = (-dir + Vector2(0.0, 0.5)).normalized() * 140.0
				accel = 300.0
				if mode_t > 2.8:
					set_mode(M.STALK)
					charge_cd = 6.0
		vel = vel.move_toward(desired, accel * d)
		position += vel * d
		position.x = clampf(position.x, -1280.0, 1280.0)
		position.y = clampf(position.y, 120.0, 3170.0)
		if vel.length() > 4.0:
			heading = lerp_angle(heading, vel.angle(), 3.0 * d)
		if dist < 22.0 and (mode == M.CHARGE or escape):
			caught = true
		# body follows the head
		var prev := position
		for i in trail.size():
			var p := trail[i]
			var dv := p - prev
			var l := dv.length()
			if l > 9.0:
				p = prev + dv / l * 9.0
			trail[i] = p
			prev = p

	func _draw() -> void:
		var n := trail.size()
		var prev := Vector2.ZERO
		for i in n:
			var p := to_local(trail[i])
			var seg := p - prev
			var nrm := Vector2(-seg.y, seg.x).normalized()
			var q := p + nrm * sin(t * 3.0 - float(i) * 0.7) * 3.0
			var w := lerpf(15.0, 1.5, float(i) / float(n))
			draw_line(prev, q, body_col, w)
			draw_circle(q, w * 0.5, body_col)
			if i % 3 == 1:
				draw_line(q, q + nrm * (w * 0.5 + 5.0), body_col.darkened(0.3), 1.0)
			prev = q
		# head (drawn along the heading, mirrored when facing left)
		var flip := -1.0 if cos(heading) < 0.0 else 1.0
		draw_set_transform(Vector2.ZERO, heading, Vector2(1.0, flip))
		var g := 2.0 + (7.0 if mode == M.CHARGE else 0.0) + sin(t * 4.0) * 0.8
		draw_colored_polygon(PackedVector2Array([Vector2(-12, 0), Vector2(26, -g * 0.5), Vector2(26, g * 0.5)]), Color(0.02, 0.0, 0.03))
		draw_colored_polygon(PackedVector2Array([Vector2(-12, -10), Vector2(8, -12), Vector2(26, -g * 0.5 - 1.5), Vector2(26, -g * 0.5), Vector2(-12, 0)]), body_col)
		draw_colored_polygon(PackedVector2Array([Vector2(-12, 0), Vector2(26, g * 0.5), Vector2(26, g * 0.5 + 2.0), Vector2(8, 12), Vector2(-12, 10)]), body_col)
		for i in 6:
			var x := 8.0 + i * 3.0
			var edge := g * 0.5 * (x + 12.0) / 38.0
			draw_colored_polygon(PackedVector2Array([Vector2(x, -edge), Vector2(x + 2.0, -edge), Vector2(x + 1.0, -edge + 3.0)]), Color(0.9, 0.9, 0.8))
			draw_colored_polygon(PackedVector2Array([Vector2(x, edge), Vector2(x + 2.0, edge), Vector2(x + 1.0, edge - 3.0)]), Color(0.9, 0.9, 0.8))
		# Lure stalk. The apex has a crown of long spines and glowing bioluminescent scars.
		draw_line(Vector2(8, -11), Vector2(34.0 + sin(t * 2.0) * 2.0, -16.0 + cos(t * 1.7) * 2.0), body_col.darkened(0.4), 1.0)
		if apex:
			for i in 5:
				var x := -8.0 + float(i) * 5.0
				draw_line(Vector2(x, -8.0), Vector2(x - 4.0, -17.0 - float(i % 2) * 5.0), Color(0.10, 0.14, 0.16), 2.0)
				draw_circle(Vector2(x - 4.0, -17.0 - float(i % 2) * 5.0), 1.4, Color(0.88, 0.18, 0.08))
			for i in 4:
