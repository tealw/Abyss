class Eyes extends Node2D:
	## Drawn in a CanvasLayer that ignores the darkness, so eyes + lure glow in the black.
	var c: Creature
	func _process(_d: float) -> void:
		if c == null:
			return
		position = c.position
		scale = c.scale
		queue_redraw()
	func _draw() -> void:
		if c == null:
			return
		var blink := 1.0 if fmod(c.t, 5.0) > 0.15 else 0.1
		var ang := c.heading
		var flip := -1.0 if cos(ang) < 0.0 else 1.0
		for s in [-1.0, 1.0]:
			var p := Vector2(8.0, 5.5 * s).rotated(ang)
			draw_circle(p, 7.0, Color(1.0, 0.6, 0.1, 0.08 * blink))
			draw_circle(p, 4.5, Color(1.0, 0.75, 0.2, 0.18 * blink))
			draw_circle(p, 3.0, Color(1.0, 0.9, 0.5, 0.95 * blink))
			draw_line(p + Vector2(0, -2.5).rotated(ang), p + Vector2(0, 2.5).rotated(ang), Color(0, 0, 0, blink), 1.0)
		var lure := Vector2(34.0 + sin(c.t * 2.0) * 2.0, (-16.0 + cos(c.t * 1.7) * 2.0) * flip).rotated(ang)
		draw_circle(lure, 8.0, Color(0.3, 0.9, 1.0, 0.10))
		draw_circle(lure, 4.0, Color(0.4, 0.95, 1.0, 0.35))
		draw_circle(lure, 2.0, Color(0.85, 1.0, 1.0, 0.95))


