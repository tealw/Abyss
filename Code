	view_toggle.anchor_right = 1.0
	view_toggle.anchor_top = 1.0
	view_toggle.anchor_bottom = 1.0
	view_toggle.offset_left = -190
	view_toggle.offset_right = -16
	view_toggle.offset_top = -68
	view_toggle.offset_bottom = -16
	view_toggle.visible = false
