func _build_display() -> void:
	sub_vp = SubViewport.new()
	sub_vp.size = Vector2i(320, 180)
	sub_vp.canvas_item_default_texture_filter = Viewport.DEFAULT_CANVAS_ITEM_TEXTURE_FILTER_NEAREST
	sub_vp.render_target_update_mode = SubViewport.UPDATE_ALWAYS
	add_child(sub_vp)

	var layer := CanvasLayer.new()
	layer.layer = 0
	add_child(layer)
	display = TextureRect.new()
	display.texture = sub_vp.get_texture()
	display.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	display.stretch_mode = TextureRect.STRETCH_SCALE
	display.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	display.mouse_filter = Control.MOUSE_FILTER_IGNORE
	display.set_anchors_preset(Control.PRESET_FULL_RECT)

	var sh := Shader.new()
	sh.code = """
shader_type canvas_item;
uniform vec2 res = vec2(320.0, 180.0);
uniform float fear = 0.0;
uniform float murk = 0.0;
uniform float blackout = 0.0;
float hash(vec2 p) { return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453); }
void fragment() {
	vec2 uv = UV;
	float t = TIME;
	uv.x += sin(uv.y * 60.0 + t * 1.7) * (0.0008 + fear * 0.0025);
	uv.y += sin(uv.x * 45.0 + t * 1.3) * 0.0006;
	float jit = step(0.97, hash(vec2(floor(t * 10.0), 3.0)));
	uv.x += jit * fear * 0.02 * (hash(vec2(floor(uv.y * res.y * 0.25), floor(t * 10.0))) - 0.5);
	float ca = (1.2 + fear * 3.0) / res.x;
	vec3 col;
	col.r = texture(TEXTURE, uv + vec2(ca, 0.0)).r;
	col.g = texture(TEXTURE, uv).g;
	col.b = texture(TEXTURE, uv - vec2(ca, 0.0)).b;
	vec2 px = floor(UV * res);
	float n = hash(px + floor(t * 14.0) * 17.0);
	col += (n - 0.5) * (0.10 + murk * 0.10);
	col *= 0.92 + 0.08 * sin(UV.y * res.y * 3.14159);
	float vig = smoothstep(0.85, 0.2, distance(UV, vec2(0.5)));
	col *= mix(0.25, 1.0, vig);
	col *= 1.0 - blackout * 0.995;
	float g = dot(col, vec3(0.299, 0.587, 0.114));
	col = mix(col, vec3(g) * vec3(0.75, 1.0, 0.95), 0.3 + murk * 0.3);
	col = mix(col, col * vec3(1.5, 0.55, 0.55), fear * 0.45);
	col = floor(col * 14.0 + 0.5) / 14.0;
	COLOR = vec4(col, 1.0);
}
"""
	fx = ShaderMaterial.new()
	fx.shader = sh
	display.material = fx
	layer.add_child(display)


func _fit() -> void:
	# keeps pixels square on any phone/tablet/desktop aspect ratio
	var win := get_viewport().get_visible_rect().size
	var asp := win.x / win.y
	if asp >= 1.0:
		sub_vp.size = Vector2i(roundi(BASE_H * asp), int(BASE_H))
	else:
		sub_vp.size = Vector2i(int(BASE_H), roundi(BASE_H / asp))
	fx.set_shader_parameter("res", Vector2(sub_vp.size))


func _cone_texture() -> ImageTexture:
	var img := Image.create(256, 256, false, Image.FORMAT_RGBA8)
	for y in 256:
		for x in 256:
			var dx := float(x)
			var dy := float(y) - 127.5
			var ang := absf(atan2(dy, maxf(dx, 0.001)))
			var ln := sqrt(dx * dx + dy * dy) / 256.0
			var a := smoothstep(0.55, 0.05, ang) * clampf(1.0 - ln, 0.0, 1.0)
			a = maxf(a, clampf(1.0 - ln * 6.0, 0.0, 1.0) * 0.6)
			img.set_pixel(x, y, Color(a, a, a, 1.0))
	return ImageTexture.create_from_image(img)


